# LEGACY (local-manifest approach, devnet-service-smoke.sh only): a local manifest registers the bare code hash, so CRT jobs
# addressed to one runner do not match it. scripts/crt-enable.sh now uses an on-chain manifest per runner (SPEC.md 5.1).
# Local CSR manifest of the CRT service (SPEC.md §5.1), rendered by scripts/crt-enable.sh: the runner lock hash
# (service args), the ELF path and the 102-byte deployment data cell file (SPEC.md §5.5) are substituted in.
# CSR's local manifest format has `data_cells` (file paths), so local mode uses the same data cell as on-chain.
name = "crt"
language = "rust"
elf = "@ELF@"
data_cells = ["@DATA@"]
args = "@R@"
