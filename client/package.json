{
  "name": "@crt/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CKB Revocable Timelock client library",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:kit": "node scripts/build-kit.mjs",
    "build": "node scripts/build-kit.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=tap test/*.test.ts"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.23.0",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
