{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "resolveJsonModule": true, "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true, "types": ["vite/client"]
  },
  "include": ["src"]
}
