{
  "name": "crt-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRT reference web app (served at /app/)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/copy-to-site.mjs",
    "test": "vitest run && node scripts/check-external.mjs",
    "test:unit": "vitest run",
    "check:external": "node scripts/check-external.mjs"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.23.0",
    "@ckb-ccc/eip6963": "^1.0.0",
    "@ckb-ccc/joy-id": "^1.0.0",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^22.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
